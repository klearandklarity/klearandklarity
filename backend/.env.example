# Copy to .env and fill in. Never commit the real .env.
# The backend loads this file automatically at startup.
# A real environment variable always wins over a value here.

# ---------------------------------------------------------------- database (MySQL)
DB_URL=jdbc:mysql://localhost:3306/klearity?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------------- auth
# CHANGE THIS. Use a long random string, for example:
#   java -e  (or any generator) -> 64+ random characters
JWT_SECRET=klearity-dev-secret-key-please-change-this-to-a-long-random-string-0123456789
JWT_EXPIRATION_MINUTES=720

# ---------------------------------------------------------------- Gmail SMTP
# Use a 16-character Google App Password, not your account password.
# https://myaccount.google.com/apppasswords  (2-Step Verification must be on)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=Klear And Klarity
MAIL_FROM_ADDRESS=
# Must match the address students actually log in with.
MAIL_BASE_URL=http://localhost:5173

# Leave blank for auto: verification is enforced only once the two values above are set.
# Set to true to always require the emailed link, false to never require it.
MAIL_VERIFICATION_REQUIRED=

# ---------------------------------------------------------------- server / CORS
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
